{
  "name": "offrava-app",
  "version": "1.0.0",
  "private": true,
  "description": "Offrava iPhone & Android app (Capacitor). The web code lives one folder up; scripts/prepare-www.mjs copies it in.",
  "scripts": {
    "www": "node scripts/prepare-www.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor '#121212' --splashBackgroundColor '#121212'",
    "patch": "node scripts/patch-native.mjs",
    "sync": "npm run www && cap sync && npm run patch",
    "live": "node scripts/live-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/local-notifications": "^8.0.0",
    "@capgo/capacitor-updater": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  },
  "offravaNative": "1.0.0"
}
